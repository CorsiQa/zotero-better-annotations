# Better Annotations
# Section title and side navigation get their text from the plugin's own
# translations (content/locale/*.js) as an argument, so that the plugin's
# language setting applies. The two header buttons only accept a message
# without arguments and therefore follow Zotero's language.
better-annotations-section-header =
    .label = { $label }
better-annotations-section-sidenav =
    .tooltiptext = { $label }
better-annotations-pin =
    .tooltiptext = 固定此部分
better-annotations-popout =
    .tooltiptext = 在独立窗口中打开
